# 复制到服务器 /etc/calculatorpro-backup.env，权限 600；不提交真实凭据。
PROJECT_DIR=/data/projects/calculatorpro
BACKUP_DIR=/data/backups/calculatorpro
BACKUP_UPLOADS_DIR=/data/uploads/calculatorpro
BACKUP_PYTHON=/data/venvs/calculatorpro-backup/bin/python
BACKUP_KEY_FILE=/data/keys/calculatorpro-backup.key
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BACKUP_BUCKET=
QINIU_S3_REGION=cn-south-1
# 先在七牛控制台确认空间为私有，再填 1。
QINIU_BACKUP_PRIVATE=0
