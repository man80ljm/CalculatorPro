# 复制为 .env 后填写。不要把真实密钥提交到仓库。

# 会话签名密钥。未设置时服务拒绝启动。
SECRET_KEY=please-change-this-to-a-long-random-string

POSTGRES_USER=calculatorpro
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=calculatorpro

# 必填，未设置时服务拒绝启动。与上面的账号一致。密码里如果有特殊字符，需要先做 URL 编码。
DATABASE_URL=postgresql+psycopg://calculatorpro:please-change-me@postgres:5432/calculatorpro

# 仅测试/本地试用：设为 1 才允许 SQLite。部署时保持注释。
# ALLOW_SQLITE=1

# DeepSeek 密钥，只放在服务器上。留空时成绩计算和表格导出仍可用，AI 报告和从大纲建课会提示未配置。
# 只填这一把时，当作单账号单钥，仍走同一套排队。
DEEPSEEK_API_KEY=
# 两个账号。逗号分隔多把密钥，或写成密钥文件路径（每行一把，空行和 # 注释会忽略）。
# 下面是假值，不要写真实密钥。
# DEEPSEEK_KEYS_A=sk-example-a1,sk-example-a2
# DEEPSEEK_KEYS_B=sk-example-b1
# 也可以单独指定文件。设置后优先于上面的 DEEPSEEK_KEYS_A / DEEPSEEK_KEYS_B。
# DEEPSEEK_KEYS_A_FILE=
# DEEPSEEK_KEYS_B_FILE=
# 每个账号同时进行的 AI 任务数。两个账号都满时，新的报告和大纲读取排队。默认 5。
# DEEPSEEK_ACCOUNT_CONCURRENCY=5
# 全站 AI 并发总上限，默认 5；多个账号合计也不能超过它。
# DEEPSEEK_GLOBAL_CONCURRENCY=5
# 文件解压后最多 100 MB（不改变达成度计算）。Excel 最多 5000 行、200 列。
# DOCUMENT_EXPANDED_MB=100
# 报告等待队列上限、恢复租约秒数、单账号保存资料容量（MB）。
# REPORT_QUEUE_LIMIT=100
# REPORT_LEASE_SECONDS=90
# USER_STORAGE_MB=2048
# 排队文案里的预计等待 = 队列位置 × 下面的秒数。报告默认 30，大纲默认 15。
# DEEPSEEK_QUEUE_REPORT_SECONDS=30
# DEEPSEEK_QUEUE_SYLLABUS_SECONDS=15
# 模型名。默认 deepseek-flash。deepseek-chat 已退役。
DEEPSEEK_MODEL=deepseek-flash
# 接口根地址，程序会请求 {DEEPSEEK_BASE_URL}/v1/chat/completions。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 只有放在 HTTPS 反向代理后面时才设为 true。教师 Cookie 和运维 Cookie 都看这个值。
COOKIE_SECURE=false

# 只读运维后台，与教师账号分开。两个都空着时后台不放行。
# 明文只写在服务器上。若设置了 ADMIN_PASSWORD_HASH，则只用哈希。
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# ADMIN_USERNAME=admin
# 设成运维子域后，该 Host 的根路径也进后台。不设则只用 /admin 路径。
# ADMIN_HOST=admin.calc.geekhuang.com

# 容器内上传目录。compose 把它挂到宿主机 /data/uploads/calculatorpro。
UPLOAD_DIR=/data/uploads

# 单个 Excel 上传上限（MB），默认 10。
MAX_UPLOAD_MB=10

# 只有直连来源属于这些网段时才信任 X-Forwarded-For（用于登录/注册限流）。
# 默认包含本机和 Docker 默认网段；宿主机反向代理 (nginx) 应设置 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for。
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
